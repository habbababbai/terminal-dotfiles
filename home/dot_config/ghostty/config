# Config generated by Ghostty Config
# https://ghostty.zerebos.com
#
# Shared cross-machine settings. Machine-specific values live in
# platform.conf (loaded at the bottom of this file).

background-opacity-cells = true

# Shader chain. Paths are relative to this file, and passes run in the order
# listed — each one receives the previous pass's output as iChannel0.
# Order matters: bloom picks up the cursor trail, and the dim goes last so it
# applies to everything above it.
custom-shader = shaders/cursor-smear.glsl
custom-shader = shaders/bloom.glsl
custom-shader = shaders/unfocused-dim.glsl
cursor-style = bar
cursor-style-blink = true
font-family = FiraCode Nerd Font Mono
font-size = 14
keybind = ctrl+grave_accent=toggle_quick_terminal
notify-on-command-finish = unfocused
palette-harmonious = true
scrollback-limit = 10000
shell-integration = zsh
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
term = xterm-256color
theme = GitHub-Dark-Colorblind
window-decoration = auto
window-padding-balance = true
window-padding-x = 16
window-padding-y = 16
window-theme = dark
working-directory = home

# Per-machine overrides. The leading `?` makes it optional, so this file
# still loads cleanly on a machine that has no platform.conf.
# Include it exactly ONCE — repeating the directive makes Ghostty report
# "cycle detected" for every extra occurrence.
config-file = ?platform.conf
