# ~/.config/zsh/local.zsh — THIS MACHINE ONLY.
#
# Created once by chezmoi from a starter template; chezmoi never overwrites it,
# and its contents never reach the repo. Put here anything that is true of this
# machine only, or that you wouldn't want in a public repo:
#
#   - machine-specific paths        export JAVA_HOME=...
#   - work/project env vars         export SOME_PROJECT_FFMPEG=...
#   - hosts and usernames           alias ssh-homelab="ssh me@host"
#   - account helpers               toggle-gh() { gh auth switch -u ... }
#
# Real secrets (API keys, tokens) belong in a password manager, not here.
